{
  "format_version": "1.2",
  "terraform_version": "1.8.4",
  "resource_changes": [
    {
      "address": "google_compute_network.custom_vpc",
      "mode": "managed",
      "type": "google_compute_network",
      "name": "custom_vpc",
      "provider_name": "registry.terraform.io/hashicorp/google",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "gcp-prod-vpc",
          "auto_create_subnetworks": false
        }
      }
    },
    {
      "address": "google_compute_subnetwork.app_subnet",
      "mode": "managed",
      "type": "google_compute_subnetwork",
      "name": "app_subnet",
      "provider_name": "registry.terraform.io/hashicorp/google",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "app-subnet-europe-west3",
          "ip_cidr_range": "10.240.0.0/20",
          "region": "europe-west3"
        }
      }
    },
    {
      "address": "google_compute_firewall.allow_rdp_all",
      "mode": "managed",
      "type": "google_compute_firewall",
      "name": "allow_rdp_all",
      "provider_name": "registry.terraform.io/hashicorp/google",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "allow-rdp-inbound",
          "direction": "INGRESS",
          "source_ranges": ["0.0.0.0/0"],
          "allow": [
            {
              "protocol": "tcp",
              "ports": ["3389"]
            }
          ]
        }
      }
    },
    {
      "address": "google_sql_database_instance.postgres_primary",
      "mode": "managed",
      "type": "google_sql_database_instance",
      "name": "postgres_primary",
      "provider_name": "registry.terraform.io/hashicorp/google",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "pg-primary-cloudsql",
          "database_version": "POSTGRES_15",
          "settings": [
            {
              "tier": "db-custom-4-16384",
              "ip_configuration": [
                {
                  "ipv4_enabled": true,
                  "authorized_networks": [
                    {
                      "name": "any-internet",
                      "value": "0.0.0.0/0"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "configuration": {
    "root_module": {
      "resources": [
        {
          "address": "google_compute_subnetwork.app_subnet",
          "type": "google_compute_subnetwork",
          "name": "app_subnet",
          "depends_on": ["google_compute_network.custom_vpc"]
        },
        {
          "address": "google_compute_firewall.allow_rdp_all",
          "type": "google_compute_firewall",
          "name": "allow_rdp_all",
          "depends_on": ["google_compute_network.custom_vpc"]
        },
        {
          "address": "google_sql_database_instance.postgres_primary",
          "type": "google_sql_database_instance",
          "name": "postgres_primary",
          "depends_on": ["google_compute_subnetwork.app_subnet"]
        }
      ]
    }
  }
}
